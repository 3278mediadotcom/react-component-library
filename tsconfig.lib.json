{
  "extends": "./tsconfig.app.json",

  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist"
  },

  "include": ["src"],

  "exclude": [
    "src/main.tsx",
    "src/App.tsx",
    "src/**/*.stories.ts",
    "src/**/*.stories.tsx",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/test"
  ]
}